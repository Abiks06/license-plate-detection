# Python
training/.venv/
__pycache__/
*.pyc

# Dataset and training outputs (reproducible via training/scripts)
data/
runs/
*.pt
!training/results/*/best.pt

# Web
web/node_modules/
web/dist/
.vercel
.env
.env*.local

# OS
.DS_Store
Thumbs.db

# Float ONNX exports are the optimizer's input; the app serves the INT8 files
# listed in web/public/model/models.json. Commit a float file only if
# optimize_model.py rejected INT8 for that variant.
web/public/model/plates-fast.onnx
web/public/model/plates-accurate.onnx
runs-*.log

# Scratch exports written next to the weights by benchmark_sizes.py / export.py
training/results/*/best.onnx
